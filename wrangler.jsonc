{
  "name": "projectrunpi-homepage",
  "compatibility_date": "2026-05-29",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "projectrunpi.com",
      "custom_domain": true
    }
  ],
  "stream": {
  "binding": "stream"
}
}